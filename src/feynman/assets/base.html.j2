{% import "meta.html.j2" as meta -%}
<!DOCTYPE html>
<html lang="en" data-theme="{{ theme }}" data-style="{{ style }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light dark">
  <title>{{ title }}</title>
  {%- if subtitle %}
  <meta name="description" content="{{ subtitle }}">
  {%- endif %}
  {%- if inline %}
  <style>{{ assets.pygments.content }}</style>
  {%- for layer in assets.css %}
  <style>{{ layer.content }}</style>
  {%- endfor %}
  {%- else %}
  <link rel="stylesheet" href="{{ assets.pygments.href }}">
  {%- for layer in assets.css %}
  <link rel="stylesheet" href="{{ layer.href }}">
  {%- endfor %}
  {%- endif %}
  <script>
    // Add the `js` class and apply the stored theme before first paint so
    // JS-only chrome appears without a flash of the wrong theme.
    document.documentElement.classList.add('js');
    try {
      var t = localStorage.getItem('feynman-theme');
      if (t === 'dark' || t === 'light') document.documentElement.dataset.theme = t;
    } catch (e) {}
  </script>
  {%- if inline %}
  <script type="module">{{ assets.js.content }}</script>
  {%- else %}
  <script type="module" src="{{ assets.js.href }}"></script>
  {%- endif %}
</head>
<body id="top">
  <a class="skip-link" href="#notebook">Skip to content</a>
  <div class="reading-progress" aria-hidden="true"></div>

  <header class="feynman-header">
    <div class="feynman-container feynman-header-inner">
      <div class="brand">
        <a class="feynman-wordmark" href="#top" aria-label="feynman, back to top">feynman<b>.</b></a>
        <span class="brand-tag">{{ tagline }}</span>
      </div>
      <nav class="header-actions" aria-label="Page navigation">
        {%- if nav.prev %}
        <a class="chapter-nav chapter-prev" href="{{ nav.prev.url }}" rel="prev" title="{{ nav.prev.title }}">
          <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M15 6l-6 6 6 6"/></svg>
          <span class="chapter-nav-label">Previous</span>
        </a>
        {%- endif %}
        {%- if home_url %}
        <a class="home-link" href="{{ home_url }}">
          <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 11.5 12 4l9 7.5M5 10v9a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-9"/></svg>
          Home
        </a>
        {%- endif %}
        {%- if nav.next %}
        <a class="chapter-nav chapter-next" href="{{ nav.next.url }}" rel="next" title="{{ nav.next.title }}">
          <span class="chapter-nav-label">Next</span>
          <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
        </a>
        {%- endif %}
        {%- block header_extra %}{% endblock %}
        <button class="icon-button feynman-theme-toggle js-only" type="button" aria-label="Switch to dark theme" aria-pressed="false">
          <svg class="icon moon-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.5 13.2A8.6 8.6 0 0 1 10.8 3.5 8.7 8.7 0 1 0 20.5 13.2Z"/></svg>
          <svg class="icon sun-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5"/></svg>
        </button>
      </nav>
    </div>
  </header>

  <main class="feynman-container">
    {%- block hero %}
    <div class="feynman-hero">
      <p class="eyebrow hero-kicker">{{ kicker }}</p>
      <h1 class="feynman-title">{{ hero_title }}</h1>
      {%- if subtitle %}
      <p class="feynman-subtitle">{{ subtitle }}</p>
      {%- endif %}
      {#- Credits and tags from the shared macros: a document that sets `authors`,
          `date`, `version` or `tags` gets them in any theme, including this
          default one, and a document that sets none gets no extra markup. #}
      {{ meta.credits(authors, date, version, variant="hero") }}
      {{ meta.tags(tags, variant="hero") }}
      {%- if source_url %}
      <p class="hero-source">
        <a href="{{ source_url }}">
          <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M14 3h7v7m0-7L10 14M19 14v5a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2h5"/></svg>
          View the source Markdown
        </a>
      </p>
      {%- endif %}
    </div>
    {%- endblock %}

    {%- block layout %}
    <div class="notebook-layout" id="notebook">
      <aside class="contents js-only" aria-hidden="true">
        <nav aria-label="Table of contents">
          <h2 class="eyebrow">In this notebook</h2>
          <ol></ol>
        </nav>
      </aside>
      <article class="feynman-prose">
        {{ body }}
      </article>
    </div>
    {%- endblock %}
    {%- if nav.prev or nav.next %}
    <nav class="chapter-pager" aria-label="Chapter navigation">
      {%- if nav.prev %}
      <a class="pager-link pager-prev" href="{{ nav.prev.url }}" rel="prev">
        <span class="pager-dir">← Previous</span>
        <span class="pager-title">{{ nav.prev.title }}</span>
      </a>
      {%- endif %}
      {%- if nav.next %}
      <a class="pager-link pager-next" href="{{ nav.next.url }}" rel="next">
        <span class="pager-dir">Next →</span>
        <span class="pager-title">{{ nav.next.title }}</span>
      </a>
      {%- endif %}
    </nav>
    {%- endif %}
  </main>

  <footer class="feynman-footer">
    <div class="feynman-container footer-inner">
      <span>Built with <a href="#top">feynman.</a></span>
      <span>{% block footer_note %}Ideas, made understandable.{% endblock %}</span>
    </div>
  </footer>

  <div class="toast" role="status" aria-live="polite"></div>
</body>
</html>
