{% extends "base.html.j2" -%}
{% import "meta.html.j2" as meta -%}
{# Research article -- paper-first: a credit row (authors / date / version), an
   optional abstract, then numbered sections in a narrow measure. Front-matter
   keys `authors`, `date`, `version`, `abstract`, `tags` drive the extras; all are
   optional and simply omit their markup when absent. The credit row and the tag
   chips come from `meta.html.j2`, shared with every other theme; here the tags
   are labelled "Keywords" and set under the abstract, as a paper sets them. #}

{% block footer_note %}Paper-first scientific communication.{% endblock %}

{% block hero %}
<header class="article-hero">
  <p class="eyebrow hero-kicker">{{ kicker }}</p>
  <h1 class="feynman-title">{{ hero_title }}</h1>
  {%- if subtitle %}
  <p class="feynman-subtitle">{{ subtitle }}</p>
  {%- endif %}
  {{ meta.credits(authors, date, version, source_url, variant="article") }}
  {#- A paper prints its keywords under the abstract, so the hero shows them only
      when there is no abstract to carry them -- never nowhere. #}
  {%- if not abstract %}
  {{ meta.tags(tags, variant="keywords", label="Keywords", show_label=true) }}
  {%- endif %}
</header>
{% endblock %}

{% block layout %}
<div class="article-layout" id="notebook">
  <aside class="contents js-only" aria-hidden="true">
    <nav aria-label="Table of contents">
      <h2 class="eyebrow">Contents</h2>
      <ol></ol>
    </nav>
  </aside>
  <article class="feynman-prose article-prose">
    {%- if abstract %}
    <section class="abstract">
      <h2>Abstract</h2>
      <p>{{ abstract }}</p>
      {#- A paper calls its tags "Keywords" and sets them inside the abstract
          block; same data and markup as any other theme's tags, relabelled. #}
      {{ meta.tags(tags, variant="keywords", label="Keywords", show_label=true) }}
    </section>
    {%- endif %}
    {{ body }}
  </article>
</div>
{% endblock %}
